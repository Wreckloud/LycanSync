{
  "name": "@lycan-sync/web",
  "version": "0.0.2",
  "private": true,
  "description": "LycanSync 语音、屏幕共享与群聊客户端",
  "author": "Wreckloud",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:activity": "cargo build --manifest-path ../../native/activity-helper/Cargo.toml --release",
    "build:media": "cargo build --manifest-path ../../native/media-helper/Cargo.toml --release --features shared-texture-output",
    "build:media-bridge": "cargo build --manifest-path ../../native/media-bridge/Cargo.toml --release --target x86_64-pc-windows-msvc",
    "build:desktop": "npm run build:media && npm run build:media-bridge && npm run build:activity && npm run build",
    "package:desktop": "npm run build:desktop && node electron/package-desktop.cjs",
    "test:media": "cargo test --manifest-path ../../native/media-helper/Cargo.toml",
    "test:electron-unit": "node --test electron/media-helper.test.cjs electron/media-diagnostics.test.cjs electron/server-settings.test.cjs electron/access-links.test.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "desktop": "npm run build:desktop && electron electron/main.cjs",
    "desktop:dev": "node electron/dev.cjs",
    "test:desktop": "npm run build:desktop && playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.41.0",
    "livekit-client": "2.22.2",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "7zip-bin": "5.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
