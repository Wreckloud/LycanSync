{
  "name": "@lycan-sync/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron electron/main.cjs",
    "test:desktop": "npm run build && playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.41.0",
    "livekit-client": "2.22.2",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "44.2.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
