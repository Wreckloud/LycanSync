<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lycansync.api.system.mapper.SystemStateMapper">

    <!-- 系统状态固定使用 id = 1，整张表至多保存一条记录。 -->
    <select id="findInitialized" resultType="java.lang.Boolean">
        SELECT initialized_at IS NOT NULL
        FROM system_state
        WHERE id = 1
    </select>
</mapper>
