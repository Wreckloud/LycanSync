# 域名必须指向部署服务器；不填写协议、端口或路径。
SERVER_DOMAIN=www.wreckloud.com
# 本机与部署环境统一使用邀请登录。
ACCOUNT_MODE=invite
ACCOUNT_SERVER_NAME=LycanSync
# QQ 互联配置；未启用时不需要填写，密钥只保留在服务器私有 .env。
QQ_ENABLED=false
QQ_APP_ID=
QQ_APP_KEY=
QQ_CALLBACK_URL=
# 公网部署填公网 IPv4；同一局域网测试填所有客户端可达的虚拟机 IPv4。
MEDIA_ADVERTISE_IP=
# 使用 openssl rand -hex 32 分别生成两个独立的随机密码。
POSTGRES_PASSWORD=
LIVEKIT_API_KEY=lycansync-server
LIVEKIT_API_SECRET=
