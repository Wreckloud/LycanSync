+void WASAPISource::GetCaptureStatus(calldata_t *cd)
+{
+	const int state = capture_status.load();
+	calldata_set_int(cd, "binding_version", 1);
+	calldata_set_int(cd, "capture_state", state);
+	calldata_set_int(cd, "sample_rate", state == 1 ? capture_sample_rate.load() : 0);
+	calldata_set_int(cd, "channels", state == 1 ? capture_channels.load() : 0);
