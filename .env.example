# PostgreSQL 数据库
# 浏览器开发地址可在私有 .env.local 中设置 LYCANSYNC_API_URL。
# 本机后端邀请入口可在私有 .env 中设置 ACCOUNT_PUBLIC_URL。
POSTGRES_PORT=5432
POSTGRES_PASSWORD=

# LiveKit 实时音视频服务
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PORT=7990
LIVEKIT_TCP_PORT=7991
LIVEKIT_UDP_PORT=7992

# 群聊普通文件存储（文件内容保存在后端私有目录，不进入 PostgreSQL）
CHAT_FILE_STORAGE_DIR=./var/chat-files
CHAT_FILE_MAX_BYTES=104857600
CHAT_FILE_STORAGE_MAX_BYTES=10737418240
